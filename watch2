<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

<title>CineView — Watch 2</title>

<link rel="icon" type="image/png" href="logo.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
>

<style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    min-height: 100%;

    background: #050507;
    color: white;

    font-family: "Poppins", Arial, sans-serif;
}

body {
    min-height: 100vh;
    min-height: 100dvh;

    overflow-x: hidden;
}

/* =========================
   BACKGROUND
========================= */

.poster-background {
    position: fixed;
    inset: -30px;

    z-index: -5;

    background-image:
        linear-gradient(
            rgba(5,5,7,.62),
            rgba(5,5,7,.93)
        ),
        url("BND.png");

    background-size: cover;
    background-position: center;

    filter:
        blur(12px)
        brightness(.7)
        saturate(.8);

    transform: scale(1.05);

    pointer-events: none;
}

body::after {
    content: "";

    position: fixed;
    inset: 0;

    z-index: -4;

    pointer-events: none;

    background:
        radial-gradient(
            circle at center,
            transparent 5%,
            rgba(0,0,0,.75) 100%
        );
}

/* =========================
   NAVBAR
========================= */

.navbar {
    position: fixed;

    top: 18px;
    left: 50%;

    transform: translateX(-50%);

    width: min(1150px, calc(100% - 30px));
    height: 64px;

    display: flex;
    align-items: center;

    padding: 0 22px;

    border:
        1px solid rgba(255,255,255,.1);

    border-radius: 18px;

    background:
        rgba(15,15,20,.58);

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    box-shadow:
        0 15px 45px rgba(0,0,0,.4);

    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;

    gap: 9px;

    color: white;

    text-decoration: none;

    font-size: 21px;
    font-weight: 700;
}

.logo img {
    width: 31px;
    height: 31px;

    object-fit: contain;

    border-radius: 8px;
}

.logo span {
    color: #ff3155;
}

.nav-links {
    display: flex;

    gap: 6px;

    margin-left: 30px;
}

.nav-links a {
    color: rgba(255,255,255,.6);

    text-decoration: none;

    padding: 9px 14px;

    border-radius: 10px;

    font-size: 13px;

    transition:
        .2s ease;
}

.nav-links a:hover,
.nav-links a.active {
    color: white;

    background:
        rgba(255,255,255,.08);
}

.nav-spacer {
    flex: 1;
}

.nav-status {
    padding: 8px 12px;

    border-radius: 10px;

    border:
        1px solid rgba(255,255,255,.07);

    background:
        rgba(255,255,255,.05);

    color:
        rgba(255,255,255,.55);

    font-size: 11px;
}

/* =========================
   PAGE
========================= */

.watch-page {
    min-height: 100vh;
    min-height: 100dvh;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding:
        105px
        20px
        40px;
}

/* =========================
   PLAYER
========================= */

.custom-player {
    position: relative;

    width: min(1100px, 100%);

    aspect-ratio: 16 / 9;

    background: black;

    overflow: hidden;

    border-radius: 18px;

    box-shadow:
        0 25px 70px rgba(0,0,0,.7),
        0 0 0 1px rgba(255,255,255,.06);

    isolation: isolate;
}

.custom-player video {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: contain;

    background: black;

    outline: none;
}

/* =========================
   TOP
========================= */

.top-overlay {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    padding: 22px 24px;

    z-index: 10;

    pointer-events: none;

    background:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.65),
            transparent
        );

    transition:
        opacity .25s ease;
}

.video-title {
    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 13px;
    font-weight: 600;
}

.title-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #ff3155;

    box-shadow:
        0 0 10px rgba(255,49,85,.8);
}

/* =========================
   CENTER PLAY
========================= */

.center-play {
    position: absolute;

    top: 50%;
    left: 50%;

    transform:
        translate(-50%,-50%);

    width: 72px;
    height: 72px;

    border:
        1px solid rgba(255,255,255,.18);

    border-radius: 50%;

    background:
        rgba(8,8,12,.8);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    color: white;

    font-size: 25px;

    cursor: pointer;

    z-index: 15;

    opacity: 0;

    pointer-events: none;

    transition:
        opacity .2s ease,
        transform .2s ease,
        background .2s ease;
}

.custom-player:not(.playing) .center-play,
.custom-player:hover .center-play {
    opacity: .95;
    pointer-events: auto;
}

.center-play:hover {
    transform:
        translate(-50%,-50%)
        scale(1.07);

    background:
        rgba(255,49,85,.9);
}

/* =========================
   CONTROLS
========================= */

.video-controls {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    min-height: 84px;

    padding:
        30px
        16px
        13px;

    display: flex;
    align-items: center;

    gap: 8px;

    z-index: 20;

    background:
        linear-gradient(
            to bottom,
            transparent,
            rgba(0,0,0,.96)
        );

    opacity: 1;

    transition:
        opacity .25s ease,
        transform .25s ease;
}

.controls-hidden .video-controls,
.controls-hidden .top-overlay {
    opacity: 0;

    pointer-events: none;
}

.control-left,
.control-right {
    display: flex;
    align-items: center;

    gap: 7px;
}

.control-right {
    margin-left: auto;
}

.control-btn {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 10px;

    background:
        rgba(255,255,255,.055);

    color: white;

    cursor: pointer;

    font-family:
        "Poppins",
        sans-serif;

    transition:
        background .15s ease,
        transform .15s ease;
}

.control-btn:hover {
    background:
        rgba(255,255,255,.14);
}

.control-btn:active {
    transform:
        scale(.92);
}

.progress-wrap {
    flex: 1;

    min-width: 80px;
}

input[type="range"] {
    appearance: none;
    -webkit-appearance: none;

    height: 4px;

    width: 100%;

    border-radius: 20px;

    background:
        rgba(255,255,255,.22);

    cursor: pointer;
}

input[type="range"]::-webkit-slider-thumb {
    appearance: none;

    width: 13px;
    height: 13px;

    border-radius: 50%;

    background: white;
}

input[type="range"]::-moz-range-thumb {
    width: 13px;
    height: 13px;

    border: 0;
    border-radius: 50%;

    background: white;
}

.time {
    color:
        rgba(255,255,255,.8);

    font-size: 11px;

    white-space: nowrap;
}

#volume {
    width: 70px;
}

/* =========================
   CC
========================= */

.cc-btn {
    font-size: 11px;
    font-weight: 700;
}

.cc-btn.active {
    background:
        rgba(255,49,85,.25);

    color:
        #ff5572;
}

/* =========================
   FULLSCREEN
========================= */

.custom-player:fullscreen,
.custom-player:-webkit-full-screen {
    width: 100vw;
    height: 100vh;

    border-radius: 0;

    box-shadow: none;
}

.custom-player:fullscreen video,
.custom-player:-webkit-full-screen video {
    width: 100%;
    height: 100%;

    object-fit: contain;
}

.custom-player:fullscreen .center-play,
.custom-player:-webkit-full-screen .center-play {
    opacity: 0 !important;

    pointer-events: none !important;
}

.custom-player:fullscreen:hover .center-play,
.custom-player:-webkit-full-screen:hover .center-play {
    opacity: 0 !important;

    pointer-events: none !important;
}

/* =========================
   STATUS
========================= */

.stream-status {
    width: min(1100px, 100%);

    margin-top: 14px;

    padding: 10px 13px;

    border-radius: 10px;

    background:
        rgba(255,255,255,.04);

    border:
        1px solid rgba(255,255,255,.07);

    color:
        rgba(255,255,255,.45);

    font-size: 10px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    .watch-page {
        padding:
            82px
            10px
            30px;
    }

    .navbar {
        top: 10px;

        width:
            calc(100% - 20px);

        height: 58px;

        padding:
            0 14px;
    }

    .logo {
        font-size: 17px;
    }

    .logo img {
        width: 27px;
        height: 27px;
    }

    .nav-links {
        margin-left: 10px;
    }

    .nav-links a {
        padding:
            8px 9px;

        font-size: 11px;
    }

    .nav-status {
        display: none;
    }

    .custom-player {
        border-radius: 12px;
    }

    .video-controls {
        min-height: 66px;

        padding:
            22px
            7px
            7px;

        gap: 4px;
    }

    .control-btn {
        width: 32px;
        height: 32px;
    }

    #volume {
        display: none;
    }

    .time {
        font-size: 9px;
    }

    .center-play {
        width: 58px;
        height: 58px;

        font-size: 20px;
    }
}

/* =========================
   ANDROID TV / TOUCH
========================= */

@media (hover: none) {

    .custom-player.playing .center-play {
        opacity: 0;

        pointer-events: none;
    }

    .custom-player:not(.playing) .center-play {
        opacity: 1;

        pointer-events: auto;
    }
}

</style>
</head>

<body>

<div class="poster-background"></div>

<div class="watch-page">

    <!-- NAVBAR -->

    <nav class="navbar">

        <a
            href="index.html"
            class="logo"
        >

            <img
                src="logo.png"
                alt="CineView"
            >

            Cine<span>View</span>

        </a>

        <div class="nav-links">

            <a href="index.html">
                Home
            </a>

            <a
                href="watch.html"
            >
                Watch
            </a>

            <a
                href="watch2.html"
                class="active"
            >
                Watch 2
            </a>

        </div>

        <div class="nav-spacer"></div>

        <div class="nav-status">
            HLS Stream
        </div>

    </nav>


    <!-- PLAYER -->

    <div
        class="custom-player"
        id="player"
    >

        <video
            id="video"
            playsinline
            webkit-playsinline
            preload="metadata"
        ></video>


        <!-- CENTER PLAY -->

        <button
            id="centerPlay"
            class="center-play"
            aria-label="Play"
        >
            ▶
        </button>


        <!-- TOP -->

        <div class="top-overlay">

            <div class="video-title">

                <span class="title-dot"></span>

                Now Playing

            </div>

        </div>


        <!-- CONTROLS -->

        <div
            class="video-controls"
            id="controls"
        >

            <div class="control-left">

                <button
                    id="playBtn"
                    class="control-btn"
                    title="Play / Pause"
                >
                    ▶
                </button>

                <button
                    id="muteBtn"
                    class="control-btn"
                    title="Mute"
                >
                    🔊
                </button>

                <input
                    id="volume"
                    type="range"
                    min="0"
                    max="1"
                    step=".01"
                    value="1"
                >

                <span
                    id="currentTime"
                    class="time"
                >
                    0:00
                </span>

                <span class="time">
                    /
                </span>

                <span
                    id="duration"
                    class="time"
                >
                    0:00
                </span>

            </div>


            <div class="progress-wrap">

                <input
                    id="progress"
                    type="range"
                    min="0"
                    max="100"
                    value="0"
                >

            </div>


            <div class="control-right">

                <button
                    id="ccBtn"
                    class="control-btn cc-btn"
                    title="Subtitles"
                >
                    CC
                </button>

                <button
                    id="fullscreenBtn"
                    class="control-btn"
                    title="Fullscreen"
                >
                    ⛶
                </button>

            </div>

        </div>

    </div>


    <div
        class="stream-status"
        id="streamStatus"
    >
        Connecting to HLS stream...
    </div>

</div>


<!-- HLS.JS -->

<script
    src="https://cdn.jsdelivr.net/npm/hls.js@latest"
></script>


<script>

/* =========================
   HLS URL
========================= */

const HLS_URL =
    "https://help.earthcleaner.cc/playlist/8845097.m3u8";


/* =========================
   ELEMENTS
========================= */

const video =
    document.getElementById("video");

const player =
    document.getElementById("player");

const playBtn =
    document.getElementById("playBtn");

const centerPlay =
    document.getElementById("centerPlay");

const muteBtn =
    document.getElementById("muteBtn");

const volume =
    document.getElementById("volume");

const progress =
    document.getElementById("progress");

const currentTime =
    document.getElementById("currentTime");

const duration =
    document.getElementById("duration");

const fullscreenBtn =
    document.getElementById("fullscreenBtn");

const ccBtn =
    document.getElementById("ccBtn");

const streamStatus =
    document.getElementById("streamStatus");


/* =========================
   HLS
========================= */

let hls = null;


/* =========================
   LOAD STREAM
========================= */

function loadStream() {

    streamStatus.textContent =
        "Connecting to HLS stream...";


    /*
       Safari / some Android browsers
       can play HLS natively.
    */

    if (
        video.canPlayType(
            "application/vnd.apple.mpegurl"
        )
    ) {

        video.src = HLS_URL;

        video.addEventListener(
            "loadedmetadata",
            () => {

                streamStatus.textContent =
                    "HLS stream ready.";

            },
            { once: true }
        );

        return;
    }


    /*
       Chrome / Edge / many Android browsers
       use hls.js.
    */

    if (
        window.Hls &&
        Hls.isSupported()
    ) {

        hls =
            new Hls({
                enableWorker: true,

                lowLatencyMode: false,

                backBufferLength: 30,

                maxBufferLength: 30,

                maxMaxBufferLength: 60
            });


        hls.loadSource(
            HLS_URL
        );

        hls.attachMedia(
            video
        );


        hls.on(
            Hls.Events.MANIFEST_PARSED,
            () => {

                streamStatus.textContent =
                    "HLS stream ready.";

            }
        );


        hls.on(
            Hls.Events.ERROR,
            (
                event,
                data
            ) => {

                console.error(
                    "HLS error:",
                    data
                );

                if (
                    data.fatal
                ) {

                    streamStatus.textContent =
                        "HLS stream error.";

                    if (
                        data.type ===
                        Hls.ErrorTypes.NETWORK_ERROR
                    ) {

                        hls.startLoad();

                    }

                    else if (
                        data.type ===
                        Hls.ErrorTypes.MEDIA_ERROR
                    ) {

                        hls.recoverMediaError();

                    }

                }

            }
        );

        return;
    }


    streamStatus.textContent =
        "This browser does not support HLS.";

}


/* =========================
   PLAY
========================= */

function togglePlay() {

    if (video.paused) {

        video.play().catch(
            error => {

                console.warn(
                    "Playback blocked:",
                    error
                );

            }
        );

    } else {

        video.pause();

    }

}


playBtn.addEventListener(
    "click",
    togglePlay
);

centerPlay.addEventListener(
    "click",
    togglePlay
);

video.addEventListener(
    "click",
    togglePlay
);


/* =========================
   PLAY STATE
========================= */

video.addEventListener(
    "play",
    () => {

        player.classList.add(
            "playing"
        );

        playBtn.textContent =
            "❚❚";

        centerPlay.textContent =
            "❚❚";

        resetControlsTimer();

    }
);

video.addEventListener(
    "pause",
    () => {

        player.classList.remove(
            "playing"
        );

        playBtn.textContent =
            "▶";

        centerPlay.textContent =
            "▶";

        showControls();

        clearTimeout(
            controlsTimer
        );

    }
);


/* =========================
   TIME
========================= */

function formatTime(seconds) {

    if (
        !Number.isFinite(seconds)
    ) {
        return "0:00";
    }

    seconds =
        Math.floor(seconds);

    const minutes =
        Math.floor(
            seconds / 60
        );

    const secs =
        seconds % 60;

    return (
        minutes +
        ":" +
        String(secs)
            .padStart(2, "0")
    );

}


video.addEventListener(
    "loadedmetadata",
    () => {

        duration.textContent =
            formatTime(
                video.duration
            );

    }
);


video.addEventListener(
    "timeupdate",
    () => {

        currentTime.textContent =
            formatTime(
                video.currentTime
            );

        if (
            Number.isFinite(
                video.duration
            ) &&
            video.duration > 0
        ) {

            progress.value =
                (
                    video.currentTime /
                    video.duration
                ) * 100;

        }

    }
);


/* =========================
   SEEK
========================= */

progress.addEventListener(
    "input",
    () => {

        if (
            !Number.isFinite(
                video.duration
            )
        ) {
            return;
        }

        video.currentTime =
            (
                progress.value / 100
            ) * video.duration;

        resetControlsTimer();

    }
);


/* =========================
   VOLUME
========================= */

volume.addEventListener(
    "input",
    () => {

        video.volume =
            Number(
                volume.value
            );

        video.muted = false;

        updateMute();

    }
);


muteBtn.addEventListener(
    "click",
    () => {

        video.muted =
            !video.muted;

        updateMute();

    }
);


function updateMute() {

    muteBtn.textContent =
        video.muted ||
        video.volume === 0
            ? "🔇"
            : "🔊";

}


/* =========================
   FULLSCREEN
========================= */

async function fullscreen() {

    const active =
        document.fullscreenElement ||
        document.webkitFullscreenElement;


    if (active) {

        if (
            document.exitFullscreen
        ) {

            await document.exitFullscreen();

        } else if (
            document.webkitExitFullscreen
        ) {

            document.webkitExitFullscreen();

        }

        return;
    }


    try {

        if (
            player.requestFullscreen
        ) {

            await player.requestFullscreen();

        }

        else if (
            player.webkitRequestFullscreen
        ) {

            player.webkitRequestFullscreen();

        }

    } catch (error) {

        console.warn(
            "Fullscreen error:",
            error
        );

    }

}


fullscreenBtn.addEventListener(
    "click",
    fullscreen
);


/* =========================
   AUTO HIDE
========================= */

let controlsTimer = null;


function showControls() {

    player.classList.remove(
        "controls-hidden"
    );

}


function hideControls() {

    if (
        video.paused
    ) {
        return;
    }

    player.classList.add(
        "controls-hidden"
    );

}


function resetControlsTimer() {

    showControls();

    clearTimeout(
        controlsTimer
    );

    if (
        !video.paused
    ) {

        controlsTimer =
            setTimeout(
                hideControls,
                3000
            );

    }

}


player.addEventListener(
    "mousemove",
    resetControlsTimer
);

player.addEventListener(
    "mouseenter",
    resetControlsTimer
);

player.addEventListener(
    "touchstart",
    resetControlsTimer,
    { passive: true }
);

player.addEventListener(
    "touchmove",
    resetControlsTimer,
    { passive: true }
);


/* =========================
   CC
========================= */

let subtitlesOn = true;


ccBtn.addEventListener(
    "click",
    () => {

        subtitlesOn =
            !subtitlesOn;

        ccBtn.classList.toggle(
            "active",
            subtitlesOn
        );


        /*
           If the HLS stream itself contains
           subtitle tracks, this attempts to
           toggle them.
        */

        if (
            video.textTracks
        ) {

            for (
                const track
                of video.textTracks
            ) {

                track.mode =
                    subtitlesOn
                        ? "showing"
                        : "hidden";

            }

        }

    }
);


/* =========================
   KEYBOARD
========================= */

document.addEventListener(
    "keydown",
    event => {

        if (
            event.target.tagName ===
            "INPUT"
        ) {
            return;
        }


        if (
            event.key === " "
        ) {

            event.preventDefault();

            togglePlay();

        }


        if (
            event.key.toLowerCase() ===
            "k"
        ) {

            togglePlay();

        }


        if (
            event.key.toLowerCase() ===
            "m"
        ) {

            video.muted =
                !video.muted;

            updateMute();

        }


        if (
            event.key.toLowerCase() ===
            "f"
        ) {

            fullscreen();

        }


        if (
            event.key ===
            "ArrowLeft"
        ) {

            video.currentTime =
                Math.max(
                    0,
                    video.currentTime - 5
                );

        }


        if (
            event.key ===
            "ArrowRight"
        ) {

            video.currentTime =
                Math.min(
                    video.duration || Infinity,
                    video.currentTime + 5
                );

        }

        resetControlsTimer();

    }
);


/* =========================
   INITIALIZE
========================= */

updateMute();

ccBtn.classList.add(
    "active"
);

showControls();

loadStream();

</script>

</body>
</html>
